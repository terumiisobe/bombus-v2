# Copy to .env and fill in. The app loads .env via spring.config.import (see application.yml).
# Never commit the real .env — it is gitignored.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/bombus
DB_USERNAME=bombus_usr
DB_PASSWORD=bombuspass

# --- Twilio WhatsApp webhook ---
# Auth token from the Twilio console; used to verify the X-Twilio-Signature header.
TWILIO_AUTH_TOKEN=
# Externally reachable base URL Twilio signs against (e.g. your ngrok https URL).
# Must match the webhook URL configured in the Twilio console exactly.
TWILIO_PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- OpenAI (conversation AI: intent parsing + reply phrasing) ---
# Required to run the app; tests use a stub and do not need a real key.
OPENAI_API_KEY=sk-...
# Optional overrides (defaults shown):
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=10s
